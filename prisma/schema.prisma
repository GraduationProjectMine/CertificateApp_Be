generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// =========================================
// Issuing Organization (Trường/Đơn vị cấp bằng)
// =========================================
model IssuingOrganization {
  organization_id   String   @id @default(uuid())
  wallet_address     String?  @unique
  organization_name  String
  contact_email      String   @unique
  logo_url           String?
  is_verified        Boolean  @default(false)
  created_at         DateTime @default(now())

  staff_accounts     StaffAccount[]
  student_accounts   StudentAccount[]
  certificates       Certificate[]
  templates          CertificateTemplate[]
  issuance_batches   IssuanceBatch[]
  audit_logs          AuditLog[]

  @@map("issuing_organization")
}

// =========================================
// Super Admin (Quản trị viên hệ thống)
// =========================================
model SuperAdmin {
  admin_id    String   @id @default(uuid())
  name        String
  email       String   @unique
  password    String
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())

  @@map("super_admins")
}

// =========================================
// Staff Account (Nhân viên thuộc 1 tổ chức)
// =========================================
model StaffAccount {
  staff_id          String   @id @default(uuid())
  organization_id   String
  name              String
  organization_name String
  email             String   @unique
  password          String
  role              String   @default("STAFF")
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  organization      IssuingOrganization @relation(fields: [organization_id], references: [organization_id])

  @@index([organization_id])
  @@map("staff_accounts")
}

// =========================================
// Student Account (Sinh viên thuộc 1 tổ chức)
// =========================================
model StudentAccount {
  student_id        String   @id @default(uuid())
  organization_id   String
  student_fullName  String
  organization_name String
  email             String   @unique
  password          String
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  organization      IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  certificates       Certificate[]

  @@index([organization_id])
  @@map("student_accounts")
}

// =========================================
// Certificate Template (Mẫu văn bằng)
// =========================================
model CertificateTemplate {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  description     String?
  design_data     Json
  thumbnail_url   String?
  is_default      Boolean  @default(false)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  organization    IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  certificates    Certificate[]

  @@index([organization_id])
  @@map("certificate_templates")
}

// =========================================
// Certificate (Văn bằng / Chứng chỉ)
// =========================================
model Certificate {
  certificate_id     String   @id @default(uuid())
  organization_id    String
  student_id         String
  template_id        String?
  certificate_title  String
  organization_name  String
  student_fullName   String
  dob                String?
  placeOfBirth       String?
  gender             String?
  ethnicity          String?
  schoolName         String?
  examCohort         String?
  examBoard          String?
  issueLocation      String?
  issueDate          String?
  serialNumber       String?
  registryNumber     String?
  ipfs_cid           String?
  tx_hash            String?
  block_number       Int?
  gas_used           String?
  status             String   @default("DRAFT") // DRAFT | PENDING | ISSUED | REVOKED
  issuedAt           DateTime @default(now())
  revokedAt          DateTime?
  revokedById        String?
  revokeReason       String?  @db.VarChar(500)
  revoke_tx_hash     String?
  revoke_block_number Int?

  organization       IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  student            StudentAccount      @relation(fields: [student_id], references: [student_id])
  template           CertificateTemplate? @relation(fields: [template_id], references: [id])

  @@index([organization_id])
  @@index([student_id])
  @@index([template_id])
  @@index([status, revokedAt])
  @@index([revokedById])
  @@map("certificate")
}

model IssuanceBatch {
  id              String   @id @default(uuid())
  organization_id String
  name            String
  status          String   @default("PROCESSING")
  totalRows       Int      @default(0)
  successRows     Int      @default(0)
  failedRows      Int      @default(0)
  createdById     String
  createdByName   String
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  organization    IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  items           IssuanceBatchItem[]

  @@index([organization_id, createdAt])
  @@map("issuance_batches")
}

model IssuanceBatchItem {
  id            String   @id @default(uuid())
  batchId       String
  rowNumber     Int
  input         Json
  status        String   @default("PENDING")
  error         String?  @db.Text
  certificateId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  batch         IssuanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("issuance_batch_items")
}

model AuditLog {
  id              String   @id @default(uuid())
  organization_id String
  actorId         String?
  actorName       String?
  action          String
  targetType      String
  targetId        String?
  ipAddress       String?
  userAgent       String?  @db.VarChar(500)
  success         Boolean  @default(true)
  details         Json?
  createdAt       DateTime @default(now())

  organization    IssuingOrganization @relation(fields: [organization_id], references: [organization_id])

  @@index([organization_id, createdAt])
  @@index([actorId])
  @@index([action])
  @@index([targetId])
  @@map("audit_logs")
}
