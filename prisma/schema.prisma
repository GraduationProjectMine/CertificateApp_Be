generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "mysql"
}

// =========================================
// Issuing Organization (Trường/Đơn vị cấp bằng)
// =========================================
model IssuingOrganization {
  organization_id   String   @id @default(uuid())
  wallet_address     String?  @unique
  organization_name  String
  contact_email      String   @unique
  logo_url           String?
  is_verified        Boolean  @default(false)
  created_at         DateTime @default(now())

  staff_accounts     StaffAccount[]
  student_accounts   StudentAccount[]
  certificates       Certificate[]

  @@map("issuing_organization")
}

// =========================================
// Staff Account (Nhân viên thuộc 1 tổ chức)
// =========================================
model StaffAccount {
  staff_id          String   @id @default(uuid())
  organization_id   String
  name              String
  organization_name String
  email             String   @unique
  password          String
  role              String   @default("STAFF")
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  organization      IssuingOrganization @relation(fields: [organization_id], references: [organization_id])

  @@index([organization_id])
  @@map("staff_accounts")
}

// =========================================
// Student Account (Sinh viên thuộc 1 tổ chức)
// =========================================
model StudentAccount {
  student_id        String   @id @default(uuid())
  organization_id   String
  student_fullName  String
  organization_name String
  email             String   @unique
  password          String
  status            String   @default("ACTIVE")
  createdAt         DateTime @default(now())

  organization      IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  certificates      Certificate[]

  @@index([organization_id])
  @@map("student_accounts")
}

// =========================================
// Certificate (Văn bằng / Chứng chỉ)
// Vòng đời: DRAFT -> APPROVED -> IPFS_UPLOADED -> BLOCKCHAIN_NOTARIZED
// =========================================
model Certificate {
  certificate_id        String   @id @default(uuid())
  organization_id       String
  student_id            String
  certificate_title     String
  organization_name     String
  student_fullName      String

  // Vòng đời hồ sơ
  status                String   @default("DRAFT")  // DRAFT | APPROVED | IPFS_UPLOADED | BLOCKCHAIN_NOTARIZED

  // Dữ liệu mở rộng
  issue_date            DateTime?                     // Ngày cấp bằng
  expiry_date           DateTime?                     // Ngày hết hạn (nếu có)
  metadata              String?                       // JSON metadata bổ sung
  template_id           String?                       // ID mẫu văn bằng

  // IPFS & Blockchain
  ipfs_cid              String?                       // CID sau khi upload IPFS
  ipfs_url              String?                       // URL gateway IPFS
  tx_hash               String?                       // Transaction hash trên blockchain

  // Thông tin kiểm duyệt
  approved_by           String?                       // Staff ID người duyệt
  approved_at           DateTime?                     // Thời gian duyệt
  rejected_reason       String?                       // Lý do từ chối (nếu có)

  // Người tạo / cập nhật
  created_by            String?
  updated_by            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  // Quan hệ
  organization          IssuingOrganization @relation(fields: [organization_id], references: [organization_id])
  student               StudentAccount      @relation(fields: [student_id], references: [student_id])

  @@index([organization_id])
  @@index([student_id])
  @@index([status])
  @@map("certificate")
}